		"@angular/platform-server": "^22.1.0",
		"@angular/router": "^22.1.0",
		"@angular/ssr": "^22.1.2",
		"express": "^5.1.0",
		"postcss": "^8.5.6",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^22.1.2",
		"@angular/cli": "^21.0.4",
